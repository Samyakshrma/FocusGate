{
  "manifest_version": 3,
  "name": "Focus Gate",
  "short_name": "Focus Gate",
  "version": "1.0.0",
  "description": "Blocks YouTube, Instagram, DelugeRPG, Slither.io, Deadshot.io and Krunker.io the whole time this extension is enabled. No popup, no switch — enabling it is the switch.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.instagram.com/*",
    "*://*.delugerpg.com/*",
    "*://*.slither.io/*",
    "*://*.deadshot.io/*",
    "*://*.krunker.io/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "blocklist",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
